# Copy to .env and fill in values locally. Never commit .env.
#
#   cp .env.example .env
#
# Provider keys are read by the LLM Gateway from this file and/or
# llm_gatewayV3/.env — at least one provider key is required to run.

# --- Agent (optional overrides) ---
LLM_GATEWAY_V3_URL=http://localhost:8101
LLM_GATEWAY_V2_URL=http://localhost:8100

# Optional: improves web_search when DuckDuckGo is rate-limited
TAVILY_API_KEY=

# --- LLM Gateway providers (set real values only in .env) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

NVIDIA_API_KEY=
NVIDIA_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

CEREBRAS_API_KEY=
CEREBRAS_MODEL=

OPEN_ROUTER_API_KEY=
OPENROUTER_MODEL=

GITHUB_ACCESS_TOKEN=
GITHUB_MODEL=

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional gateway settings
LLM_ORDER=
GATEWAY_PORT=8099
